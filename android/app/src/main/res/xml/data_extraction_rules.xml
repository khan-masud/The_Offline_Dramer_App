<?xml version="1.0" encoding="utf-8"?>
<!--
   data_extraction_rules.xml
   Disables Android cloud backup completely for privacy.
   No app data is uploaded to Google Drive.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
    </device-transfer>
</data-extraction-rules>
